# Local demonstration. Set google_sheets on Render for real records.
EITDA_DATA_MODE=mock
EITDA_APPS_SCRIPT_URL=
# Generate 32 random bytes as 64 lowercase hex characters; also set API_SECRET in Apps Script.
EITDA_APPS_SCRIPT_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.eshietfoundation.xyz
# Use the existing Render/Node runtime locally on Windows.
RENDER=true
